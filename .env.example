# Copy this file to .env and fill it in. NEVER commit .env to Git.

# Your own OpenRouter API key (https://openrouter.ai/keys).
# Optional: you can also paste it into the app (sidebar -> API key).
OPENROUTER_API_KEY=

# Where the web app listens. Keep 127.0.0.1 unless you know what you are doing.
HOST=127.0.0.1
PORT=8080

# Optional overrides
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# REQUEST_TIMEOUT_SECONDS=90
